@model List<CreateHomeContactDto>

@{
    int counter = 1;
}

<div class="col-xl-12">
    <section class="box ">
        <header class="panel_header">
            <h2 class="title float-left">Mesaj Listesi</h2>
        </header>
        <div class="content-body">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-12">

                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th style="text-align: left;">Konu</th>
                                <th style="text-align: left;">İsim</th>
                                <th style="text-align: left;">Soyisim</th>
                                <th style="text-align: left;">Mail Adresi</th>
                                <th style="text-align: right;">Mesajı Gör</th>
                                <th style="text-align: right;">Cevapla</th>
                                <th style="text-align: right;">Sil</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@counter</th>
                                    <td style="text-align: left;">@item.Topic</td>
                                    <td style="text-align: left;">@item.Name</td>
                                    <td style="text-align: left;">@item.Surname</td>
                                    <td style="text-align: left;">@item.EmailAddress</td>
                                    <td style="text-align: right;">
                                        <a href="javascript:void(0);" class="open-mail-modal" data-id="@item.ID">
                                            <i class="fa fa-eye text-warning" style="font-size: 20px !important;"></i>
                                        </a>
                                    </td>
                                    <td style="text-align: right;">
                                        <a class="btn btn-link p-0 m-0" title="Cevapla" href="/Admin/Dashboard/AnswerMail/@item.ID">
                                            <i class="fa fa-reply text-success" style="font-size: 20px !important;"></i>
                                        </a>
                                    </td>
                                    <td style="text-align: right;">
                                        <form asp-action="DeleteMailList" asp-controller="Dashboard" asp-area="Admin" method="post" style="display:inline" onsubmit="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ID" />

                                            <button type="submit" class="btn btn-link p-0 m-0" title="Sil">
                                                <i class="fa fa-eraser text-danger" style="font-size: 20px !important;"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>



<!-- Modal (tek bir tane) -->
<div class="modal fade" id="mailModal" tabindex="-1" role="dialog" aria-labelledby="mailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Mesaj Detayı</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <label>İsim</label>
                        <input type="text" class="form-control" id="modalName" readonly />
                    </div>
                    <div class="col-md-6">
                        <label>Soyisim</label>
                        <input type="text" class="form-control" id="modalSurname" readonly />
                    </div>
                    <div class="col-md-6">
                        <label>Email</label>
                        <input type="text" class="form-control" id="modalEmail" readonly />
                    </div>
                    <div class="col-md-6">
                        <label>Konu</label>
                        <input type="text" class="form-control" id="modalTopic" readonly />
                    </div>
                    <div class="col-md-12">
                        <label>Mesaj</label>
                        <textarea class="form-control" id="modalMessage" rows="6" readonly></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


