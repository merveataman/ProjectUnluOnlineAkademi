<script>
    document.querySelectorAll('.open-mail-modal').forEach(button => {
        button.addEventListener('click', async function () {
            const id = this.dataset.id;
            const modal = $('#mailModal');

            // Önce temizle/yükleniyor göster
            document.getElementById('modalName').value = 'Yükleniyor...';
            document.getElementById('modalSurname').value = '';
            document.getElementById('modalEmail').value = '';
            document.getElementById('modalTopic').value = '';
            document.getElementById('modalMessage').value = '';

            modal.modal('show');

            try {
                const response = await fetch(`/Admin/Dashboard/GetMailList?id=${id}`);
                if (!response.ok) throw new Error('Veri alınamadı');
                const data = await response.json();

                document.getElementById('modalName').value = data.name;
                document.getElementById('modalSurname').value = data.surname;
                document.getElementById('modalEmail').value = data.emailAddress;
                document.getElementById('modalTopic').value = data.topic;
                document.getElementById('modalMessage').value = data.message;
            } catch (error) {
                document.getElementById('modalMessage').value = 'Mesaj getirilemedi.';
            }
        });
    });
</script>

