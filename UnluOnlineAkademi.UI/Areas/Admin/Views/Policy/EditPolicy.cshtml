@model UnluOnlineAkademi.UI.DTOs.PoliciesDto.UpdatePoliciesDto
@{
    ViewData["Title"] = "EdiPolicy";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<!-- OTHER SCRIPTS INCLUDED ON THIS PAGE - START -->
<link href="~/admin-template/assets/plugins/datepicker/css/datepicker.css" rel="stylesheet" type="text/css" media="screen" />        <!-- OTHER SCRIPTS INCLUDED ON THIS PAGE - END -->

<section id="main-content" class=" ">
    <section class="wrapper main-wrapper" style=''>

        <div class='col-xl-12 col-lg-12 col-md-12 col-12'>
            <div class="page-title">

                <div class="float-left">
                    <h1 class="title">Politika Düzenle</h1>
                </div>

                <div class="float-right">
                    <ol class="breadcrumb">
                        <li>
                            <a href="/Adin/Dashboard/Index"><i class="fa fa-home"></i>Dashboard</a>
                        </li>
                        <li>
                            <a href="/Admin/Policy/Index"> /Politikalar</a>
                        </li>
                        <li class="active">
                            <strong> /Düzenle</strong>
                        </li>
                    </ol>
                </div>

            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-xl-12 col-lg-12 col-12 col-md-12">
            <section class="box ">
                <header class="panel_header">
                    <h2 class="title float-left">Politikalar</h2>
                    <div class="actions panel_actions float-right">
                    </div>
                </header>
                <div class="content-body">
                    <div class="row">
                        <form asp-action="EditPolicy" asp-controller="Policy" asp-area="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ID" value="@Model.ID" />
                            <div class="col-xl-8 col-lg-8 col-md-9 col-12 padding-bottom-30">
                                <div class="form-group">
                                    <label class="form-label" for="">Politika Başlığı</label>
                                    <input type="text" class="form-control" name="Title" value="@Model.Title">
                                </div>
                            </div>

                            <div class="col-xl-12 col-lg-12 col-md-12 col-12">
                                <div class="form-group">
                                    <label class="form-label" for="field-5">Politika İçeriği</label>
                                    <textarea class="ckeditor" cols="80" name="Desc" rows="10">@Model.Desc</textarea><br>
                                </div>
                            </div>

                            <div class="col-xl-8 col-lg-8 col-md-9 col-12 padding-bottom-30">

                                <div class="col-xl-8 col-lg-8 col-md-9 col-12 padding-bottom-30">
                                    <div class="text-left">
                                        <button type="submit" class="btn btn-success">Kaydet</button>
                                        <button type="button" class="btn btn-danger">İptal </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </div>

    </section>
</section>

<!-- OTHER SCRIPTS INCLUDED ON THIS PAGE - START -->
<script src="~/admin-template/assets/plugins/datepicker/js/datepicker.js" type="text/javascript"></script>
<script src="~/admin-template/assets/plugins/autosize/autosize.min.js" type="text/javascript"></script>
<script src="~/admin-template/assets/plugins/inputmask/min/jquery.inputmask.bundle.min.js" type="text/javascript"></script>
<script src="~/admin-template/assets/plugins/ckeditor/ckeditor.js" type="text/javascript"></script><!-- OTHER SCRIPTS INCLUDED ON THIS PAGE - END --> 